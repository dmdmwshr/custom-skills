{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-cases.meifu.zzxhlyj.top/contracts/CaseFileSupplementManifestV1.schema.json",
  "title": "CaseFileSupplementManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectNo",
    "baseSnapshotDigest",
    "mode",
    "createdAt",
    "files",
    "documentSlots"
  ],
  "properties": {
    "schemaVersion": { "const": "CaseFileSupplementManifestV1" },
    "projectNo": { "type": "string", "pattern": "^[0-9]{8}[A-Z][0-9]{9}$" },
    "baseSnapshotDigest": {
      "$ref": "CaseImportManifestV2.schema.json#/$defs/sha256"
    },
    "mode": { "const": "MISSING_ONLY" },
    "packageSha256": {
      "$ref": "CaseImportManifestV2.schema.json#/$defs/sha256"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "CaseImportManifestV2.schema.json#/$defs/file" }
    },
    "documentSlots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/documentSlot" }
    }
  },
  "$defs": {
    "ownerKey": {
      "oneOf": [
        { "const": "case" },
        { "enum": ["inspection:INITIAL_CHECK", "inspection:RECHECK"] },
        {
          "type": "string",
          "pattern": "^product:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        { "enum": ["notification:PRODUCTION", "notification:SALES"] }
      ]
    },
    "documentSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientRef", "slotCode", "ownerKey", "versions"],
      "properties": {
        "clientRef": {
          "$ref": "CaseImportManifestV2.schema.json#/$defs/clientRef"
        },
        "slotCode": {
          "$ref": "CaseImportManifestV2.schema.json#/$defs/slotCode"
        },
        "ownerKey": { "$ref": "#/$defs/ownerKey" },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "CaseImportManifestV2.schema.json#/$defs/fileVersion"
          }
        }
      }
    }
  }
}
