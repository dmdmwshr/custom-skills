{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-cases.meifu.zzxhlyj.top/contracts/CaseImportManifestV2.schema.json",
  "title": "CaseImportManifestV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageSha256",
    "createdAt",
    "case",
    "initialInspection",
    "files",
    "documentSlots"
  ],
  "properties": {
    "schemaVersion": { "const": "CaseImportManifestV2" },
    "packageSha256": { "$ref": "#/$defs/sha256" },
    "createdAt": { "type": "string", "format": "date-time" },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "case": { "$ref": "#/$defs/case" },
    "initialInspection": { "$ref": "#/$defs/initialInspection" },
    "recheckInspection": { "$ref": "#/$defs/recheckInspection" },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "documentSlots": {
      "type": "array",
      "items": { "$ref": "#/$defs/documentSlot" }
    },
    "otherAttachments": {
      "type": "array",
      "items": { "$ref": "#/$defs/otherAttachment" }
    }
  },
  "$defs": {
    "clientRef": { "type": "string", "pattern": "^[a-z][a-z0-9:_-]{0,159}$" },
    "sha256": { "type": "string", "pattern": "^(sha256:)?[a-fA-F0-9]{64}$" },
    "date": { "type": "string", "format": "date" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectNo", "brigadeCode", "unitName"],
      "properties": {
        "projectNo": { "type": "string", "pattern": "^[0-9]{8}[A-Z][0-9]{9}$" },
        "brigadeCode": {
          "enum": [
            "JIANGYIN",
            "YIXING",
            "LIANGXI",
            "XISHAN",
            "HUISHAN",
            "BINHU",
            "XINWU",
            "JINGKAI"
          ]
        },
        "unitName": { "type": "string", "minLength": 1 },
        "unitAddress": { "type": "string" },
        "inspectionForm": {
          "enum": ["ROUTINE", "SPECIAL", "COMPLAINT", "OTHER", "UNKNOWN"]
        },
        "handler": { "type": "string" },
        "inspector": { "type": "string" },
        "legalRepresentative": { "type": "string" },
        "documentRecipient": { "type": "string" },
        "criminalCaseOverride": { "type": "boolean" },
        "notificationTarget": {
          "enum": ["PRODUCTION", "SALES", "BOTH", "UNKNOWN"]
        }
      }
    },
    "inspectionProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientRef", "name"],
      "properties": {
        "clientRef": { "$ref": "#/$defs/clientRef" },
        "name": { "type": "string", "minLength": 1 },
        "modelSpec": { "type": "string" },
        "nominalProducer": { "type": "string" },
        "location": { "type": "string" },
        "method": { "enum": ["ONSITE", "SAMPLING"] },
        "result": {
          "enum": ["UNKNOWN", "PENDING", "QUALIFIED", "UNQUALIFIED"]
        },
        "onlineSale": { "enum": ["YES", "NO", "UNKNOWN"] },
        "maintenance": { "enum": ["YES", "NO", "UNKNOWN"] },
        "marketAccessMode": {
          "enum": ["CCC", "TECHNICAL_APPRAISAL", "NOT_APPLICABLE", "UNKNOWN"]
        },
        "problemDescription": { "type": "string" },
        "reinspectionApplied": { "enum": ["YES", "NO", "UNKNOWN"] },
        "reinspectionResult": {
          "enum": ["UNKNOWN", "PENDING", "QUALIFIED", "UNQUALIFIED"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "result": { "const": "UNQUALIFIED" } },
            "required": ["result"]
          },
          "then": {
            "required": ["method", "problemDescription"],
            "properties": {
              "problemDescription": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "required": ["result"] },
          "then": { "required": ["method"] }
        },
        {
          "if": {
            "properties": { "method": { "const": "ONSITE" } },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "result": { "enum": ["UNKNOWN", "QUALIFIED", "UNQUALIFIED"] }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              { "required": ["reinspectionApplied"] },
              { "required": ["reinspectionResult"] }
            ]
          },
          "then": {
            "required": ["method"],
            "properties": { "method": { "const": "SAMPLING" } }
          }
        }
      ]
    },
    "initialInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientRef", "stage", "products"],
      "properties": {
        "clientRef": { "$ref": "#/$defs/clientRef" },
        "stage": { "const": "INITIAL_CHECK" },
        "inspectionDate": { "$ref": "#/$defs/date" },
        "products": {
          "type": "array",
          "items": { "$ref": "#/$defs/inspectionProduct" }
        }
      }
    },
    "recheckInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientRef", "stage", "products"],
      "properties": {
        "clientRef": { "$ref": "#/$defs/clientRef" },
        "stage": { "const": "RECHECK" },
        "inspectionDate": { "$ref": "#/$defs/date" },
        "products": {
          "type": "array",
          "items": { "$ref": "#/$defs/inspectionProduct" }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientRef", "relativePath", "sha256", "mimeType"],
      "properties": {
        "clientRef": { "$ref": "#/$defs/clientRef" },
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mimeType": { "const": "application/pdf" },
        "pageCount": { "type": "integer", "minimum": 1 }
      }
    },
    "fileVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fileRef"],
      "properties": {
        "kind": { "enum": ["ELECTRONIC", "SCANNED"] },
        "fileRef": { "$ref": "#/$defs/clientRef" }
      }
    },
    "documentSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientRef", "slotCode", "versions"],
      "properties": {
        "clientRef": { "$ref": "#/$defs/clientRef" },
        "slotCode": { "$ref": "#/$defs/slotCode" },
        "inspectionRef": { "$ref": "#/$defs/clientRef" },
        "productRef": { "$ref": "#/$defs/clientRef" },
        "notificationTarget": { "enum": ["PRODUCTION", "SALES"] },
        "documentNo": { "type": "string" },
        "documentDate": { "$ref": "#/$defs/date" },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/fileVersion" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "not": {
            "properties": { "slotCode": { "const": "OTHER_ATTACHMENT" } },
            "required": ["slotCode"]
          }
        },
        {
          "not": {
            "properties": {
              "versions": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": { "kind": { "const": "ELECTRONIC" } },
                  "required": ["kind"]
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "versions": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": { "kind": { "const": "SCANNED" } },
                  "required": ["kind"]
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "slotCode": {
                "enum": ["INITIAL_ONSITE_PHOTO", "RECHECK_ONSITE_PHOTO"]
              }
            },
            "required": ["slotCode"]
          },
          "then": {
            "properties": {
              "versions": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "properties": { "kind": { "const": "SCANNED" } },
                  "required": ["kind"]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "slotCode": {
                "enum": [
                  "ILLEGAL_PRODUCT_NOTIFICATION_APPROVAL",
                  "ILLEGAL_PRODUCT_NOTIFICATION_LETTER",
                  "ILLEGAL_PRODUCT_NOTIFICATION_RECEIPT"
                ]
              }
            },
            "required": ["slotCode"]
          },
          "then": { "required": ["notificationTarget"] }
        }
      ]
    },
    "otherAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientRef", "slotCode", "fileRef"],
      "properties": {
        "clientRef": { "$ref": "#/$defs/clientRef" },
        "slotCode": { "const": "OTHER_ATTACHMENT" },
        "title": { "type": "string" },
        "fileRef": { "$ref": "#/$defs/clientRef" }
      }
    },
    "slotCode": {
      "enum": [
        "AUTHORIZATION_LETTER",
        "BUSINESS_LICENSE",
        "INITIAL_INSPECTION_RECORD",
        "INITIAL_ONSITE_PHOTO",
        "INITIAL_CCC_CERTIFICATE",
        "INITIAL_TECHNICAL_APPRAISAL_CERTIFICATE",
        "INITIAL_TYPE_TEST_REPORT",
        "INITIAL_PURCHASE_RECORD_INVOICE",
        "INITIAL_MAINTENANCE_RECORD",
        "INITIAL_SAMPLING_FORM",
        "INITIAL_SAMPLING_TEST_REPORT",
        "INITIAL_QUALITY_RESULT_APPROVAL",
        "INITIAL_QUALITY_RESULT_NOTICE",
        "INITIAL_QUALITY_RESULT_RECEIPT",
        "INITIAL_REINSPECTION_APPLICATION",
        "INITIAL_REINSPECTION_ACCEPTANCE",
        "INITIAL_REINSPECTION_REPORT",
        "INITIAL_REINSPECTION_QUALITY_RESULT_APPROVAL",
        "INITIAL_REINSPECTION_QUALITY_RESULT_NOTICE",
        "INITIAL_REINSPECTION_QUALITY_RESULT_RECEIPT",
        "ONSITE_UNQUALIFIED_APPROVAL",
        "ONSITE_UNQUALIFIED_NOTICE",
        "ONSITE_UNQUALIFIED_RECEIPT",
        "RECTIFICATION_APPROVAL",
        "RECTIFICATION_ORDER",
        "RECTIFICATION_RECEIPT",
        "EVIDENCE_PRESERVATION_APPROVAL",
        "EVIDENCE_PRESERVATION_DECISION",
        "EVIDENCE_PRESERVATION_INVENTORY",
        "ILLEGAL_PRODUCT_NOTIFICATION_APPROVAL",
        "ILLEGAL_PRODUCT_NOTIFICATION_LETTER",
        "ILLEGAL_PRODUCT_NOTIFICATION_RECEIPT",
        "RECHECK_INSPECTION_RECORD",
        "RECHECK_ONSITE_PHOTO",
        "RECHECK_CCC_CERTIFICATE",
        "RECHECK_TECHNICAL_APPRAISAL_CERTIFICATE",
        "RECHECK_TYPE_TEST_REPORT",
        "RECHECK_PURCHASE_RECORD_INVOICE",
        "RECHECK_MAINTENANCE_RECORD",
        "RECHECK_SAMPLING_FORM",
        "RECHECK_SAMPLING_TEST_REPORT",
        "RECHECK_QUALITY_RESULT_APPROVAL",
        "RECHECK_QUALITY_RESULT_NOTICE",
        "RECHECK_QUALITY_RESULT_RECEIPT",
        "RECHECK_REINSPECTION_APPLICATION",
        "RECHECK_REINSPECTION_ACCEPTANCE",
        "RECHECK_REINSPECTION_REPORT",
        "RECHECK_REINSPECTION_QUALITY_RESULT_APPROVAL",
        "RECHECK_REINSPECTION_QUALITY_RESULT_NOTICE",
        "RECHECK_REINSPECTION_QUALITY_RESULT_RECEIPT",
        "OTHER_ATTACHMENT"
      ]
    }
  }
}
